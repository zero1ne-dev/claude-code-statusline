#!/opt/homebrew/bin/bash
# ============================================================================
# Claude Code - Per-Prompt Token Usage Analyzer
# ============================================================================
# Analyzes a session JSONL file to identify which user prompts consumed the
# most tokens, with actionable recommendations to reduce usage.
#
# Usage:
#   prompt-analysis                          # Analyze most recent session
#   prompt-analysis <session.jsonl>          # Analyze a specific session file
#   prompt-analysis --days N                 # Sessions from last N days
#   prompt-analysis --limit N                # Show top N prompts (default 10)
# ============================================================================

set -euo pipefail

# ============================================================================
# ARGS
# ============================================================================
TARGET_FILE=""
MODE="session"
DAYS=1
LIMIT=10

while [[ $# -gt 0 ]]; do
    case "$1" in
        --today)     MODE="days"; DAYS=1; shift ;;
        --days)      MODE="days"; DAYS="$2"; shift 2 ;;
        --limit)     LIMIT="$2"; shift 2 ;;
        -h|--help)
            echo "Usage: prompt-analysis [session.jsonl] [--today] [--days N] [--limit N]"
            exit 0 ;;
        *.jsonl)     TARGET_FILE="$1"; shift ;;
        *)           shift ;;
    esac
done

# ============================================================================
# COLORS
# ============================================================================
RED=$'\033[31m'; YELLOW=$'\033[33m'; GREEN=$'\033[32m'
CYAN=$'\033[36m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'

PROJECTS_DIR="$HOME/.claude/projects"

# ============================================================================
# HELPERS
# ============================================================================
fmt_tokens() {
    local t="$1"
    if [[ "$t" -ge 1000000 ]]; then
        printf "%.1fM" "$(echo "scale=1; $t / 1000000" | bc)"
    elif [[ "$t" -ge 1000 ]]; then
        printf "%.1fK" "$(echo "scale=1; $t / 1000" | bc)"
    else
        echo "${t}"
    fi
}

color_for_tokens() {
    local t="$1"
    if   [[ "$t" -ge 200000 ]]; then echo "$RED"
    elif [[ "$t" -ge 50000  ]]; then echo "$YELLOW"
    else echo "$GREEN"
    fi
}

# Extract human-readable label from a raw user prompt string
# Filters out OMC hooks, task notifications, stop hooks, etc.
extract_prompt_label() {
    local raw="$1"
    # Skip system/hook injected messages
    if echo "$raw" | grep -qE "^(Stop hook feedback:|<task-notification|<command-message>oh-my-claudecode:|<command-message>oh-my-claude)"; then
        echo ""
        return
    fi
    # Extract slash command name if present
    if echo "$raw" | grep -q "<command-name>"; then
        echo "$raw" | grep -o '<command-name>[^<]*</command-name>' | sed 's|<[^>]*>||g' | head -1
        return
    fi
    # Plain user text — strip newlines, truncate
    echo "$raw" | tr '\n' ' ' | sed 's/^[[:space:]]*//' | cut -c1-120
}

# ============================================================================
# RECOMMENDATION ENGINE
# ============================================================================
recommend() {
    local inp="$1" cc="$2" cr="$3" out="$4" turns="$5"
    local tips=()

    if [[ "$cc" -gt 30000 ]]; then
        tips+=("🗜  Large cache write ($(fmt_tokens $cc)) — run /compact to shrink context")
    elif [[ "$cc" -gt 8000 ]]; then
        tips+=("📦 Growing context ($(fmt_tokens $cc) new cache) — consider /compact soon")
    fi

    if [[ "$cr" -gt 100000 ]]; then
        tips+=("📚 Reading huge context ($(fmt_tokens $cr)) — /compact would cut this significantly")
    fi

    if [[ "$inp" -gt 15000 ]]; then
        tips+=("📄 High direct input ($(fmt_tokens $inp)) — avoid reading large files in full")
    fi

    if [[ "$out" -gt 8000 ]]; then
        tips+=("📝 Verbose output ($(fmt_tokens $out)) — ask for concise answers or summaries")
    fi

    if [[ "$turns" -gt 30 ]]; then
        tips+=("🔄 Many API calls (${turns}) — long agent chain, start fresh session to reset")
    fi

    if [[ "${#tips[@]}" -gt 0 ]]; then
        local IFS=$'\n'
        echo "${tips[*]}"
    fi
}

# ============================================================================
# ANALYZE ONE JSONL FILE
# ============================================================================
analyze_session() {
    local jsonl_file="$1"
    if [[ ! -f "$jsonl_file" ]]; then return; fi

    local session_id
    session_id=$(basename "$jsonl_file" .jsonl)
    local dir_encoded
    dir_encoded=$(basename "$(dirname "$jsonl_file")")
    local project_label
    project_label=$(echo "$dir_encoded" | sed 's|^-Users-[^-]*||' | sed 's|-|/|g' | sed 's|^/||')
    if [[ -z "$project_label" ]]; then project_label="(root)"; fi

    # Extract entries: user prompts (string content) and assistant token usage
    # User prompt: type=="user", message.content is a string
    # Assistant:   type=="assistant" with message.usage
    local entries
    entries=$(jq -r '
        if .type == "user" and (.message.content | type == "string") then
            ["USER", .timestamp, .uuid,
             "0","0","0","0",
             (.message.content | gsub("\n";" ") | .[0:200])
            ] | @tsv

        elif .type == "assistant" and .message.usage != null then
            ["ASST", .timestamp, .uuid,
             (.message.usage.input_tokens // 0 | tostring),
             (.message.usage.cache_creation_input_tokens // 0 | tostring),
             (.message.usage.cache_read_input_tokens // 0 | tostring),
             (.message.usage.output_tokens // 0 | tostring),
             ""
            ] | @tsv
        else empty
        end
    ' "$jsonl_file" 2>/dev/null | sort -t$'\t' -k2)

    if [[ -z "$entries" ]]; then return; fi

    # -----------------------------------------------------------------------
    # Build turn list: each USER entry starts a turn; accumulate ASST tokens
    # -----------------------------------------------------------------------
    local -a turns_label=() turns_ts=() turns_inp=() turns_cc=() turns_cr=() turns_out=() turns_count=()
    local cur_label="" cur_ts="" cur_inp=0 cur_cc=0 cur_cr=0 cur_out=0 cur_count=0

    while IFS=$'\t' read -r etype ets euuid einp ecc ecr eout etext; do
        if [[ "$etype" == "USER" ]]; then
            local label
            label=$(extract_prompt_label "$etext")
            if [[ -z "$label" ]]; then continue; fi  # skip hook injections

            # Flush previous turn
            local _t=$(( cur_inp + cur_cc + cur_cr + cur_out ))
            if [[ "$_t" -gt 0 ]]; then
                turns_label+=("$cur_label")
                turns_ts+=("$cur_ts")
                turns_inp+=("$cur_inp")
                turns_cc+=("$cur_cc")
                turns_cr+=("$cur_cr")
                turns_out+=("$cur_out")
                turns_count+=("$cur_count")
            fi

            cur_label="$label"
            cur_ts="$ets"
            cur_inp=0; cur_cc=0; cur_cr=0; cur_out=0; cur_count=0

        elif [[ "$etype" == "ASST" ]]; then
            cur_inp=$(( cur_inp + einp ))
            cur_cc=$(( cur_cc + ecc ))
            cur_cr=$(( cur_cr + ecr ))
            cur_out=$(( cur_out + eout ))
            cur_count=$(( cur_count + 1 ))
        fi
    done <<< "$entries"

    # Flush last turn
    local _t=$(( cur_inp + cur_cc + cur_cr + cur_out ))
    if [[ "$_t" -gt 0 ]]; then
        turns_label+=("$cur_label")
        turns_ts+=("$cur_ts")
        turns_inp+=("$cur_inp")
        turns_cc+=("$cur_cc")
        turns_cr+=("$cur_cr")
        turns_out+=("$cur_out")
        turns_count+=("$cur_count")
    fi

    # Also capture any assistant activity before the first identified user prompt
    # (session start — model responding to initial context)

    local n="${#turns_label[@]}"
    if [[ "$n" -eq 0 ]]; then return; fi

    # Sort by total tokens descending
    local -a indexed=()
    local session_total=0
    for ((i=0; i<n; i++)); do
        local t=$(( turns_inp[i] + turns_cc[i] + turns_cr[i] + turns_out[i] ))
        indexed+=("$t|$i")
        session_total=$(( session_total + t ))
    done
    IFS=$'\n' sorted_idx=($(sort -rn <<<"${indexed[*]}")); unset IFS

    echo ""
    echo "${BOLD}Session:${RESET} ${CYAN}${session_id:0:8}${RESET}  ${DIM}${project_label}${RESET}"
    echo "${DIM}$(printf '%0.s─' {1..82})${RESET}"
    printf "${DIM}%-4s %-28s %8s %8s %8s %8s %6s${RESET}\n" \
        "#" "Prompt" "Total" "CacheNew" "CacheHit" "Output" "Calls"
    echo "${DIM}$(printf '%0.s─' {1..82})${RESET}"

    local shown=0
    for entry in "${sorted_idx[@]}"; do
        if [[ $shown -ge $LIMIT ]]; then break; fi
        local i="${entry#*|}"
        local t_total=$(( turns_inp[i] + turns_cc[i] + turns_cr[i] + turns_out[i] ))
        if [[ "$t_total" -eq 0 ]]; then continue; fi

        local col
        col=$(color_for_tokens "$t_total")
        local label="${turns_label[i]}"
        if [[ ${#label} -gt 26 ]]; then label="${label:0:25}…"; fi

        printf "${col}%-4s${RESET} %-28s %8s %8s %8s %8s %6s\n" \
            "$((shown+1))." \
            "$label" \
            "$(fmt_tokens $t_total)" \
            "$(fmt_tokens ${turns_cc[i]})" \
            "$(fmt_tokens ${turns_cr[i]})" \
            "$(fmt_tokens ${turns_out[i]})" \
            "${turns_count[i]}"

        # Recommendations for expensive turns
        if [[ "$t_total" -gt 8000 ]]; then
            local recs
            recs=$(recommend "${turns_inp[i]}" "${turns_cc[i]}" "${turns_cr[i]}" "${turns_out[i]}" "${turns_count[i]}")
            if [[ -n "$recs" ]]; then
                while IFS= read -r tip; do
                    if [[ -n "$tip" ]]; then printf "       ${DIM}%s${RESET}\n" "$tip"; fi
                done <<< "$recs"
            fi
        fi

        shown=$(( shown + 1 ))
    done

    echo "${DIM}$(printf '%0.s─' {1..82})${RESET}"
    echo "  Session total: ${CYAN}$(fmt_tokens $session_total)${RESET} tokens across ${n} prompt turn(s)"
}

# ============================================================================
# MAIN
# ============================================================================
echo ""
echo "${BOLD}Claude Code Per-Prompt Token Analyzer${RESET}"

if [[ -n "$TARGET_FILE" && -f "$TARGET_FILE" ]]; then
    analyze_session "$TARGET_FILE"

elif [[ "$MODE" == "days" ]]; then
    if [[ "$(uname -s)" == "Darwin" ]]; then
        CUTOFF=$(date -v-${DAYS}d -u +"%Y-%m-%dT%H:%M:%SZ")
    else
        CUTOFF=$(date -d "$DAYS days ago" -u +"%Y-%m-%dT%H:%M:%SZ")
    fi
    echo "${DIM}Scanning sessions from last ${DAYS} day(s) ...${RESET}"

    while IFS= read -r f; do
        has_recent=$(jq -rn --arg c "$CUTOFF" 'first(inputs | select(.timestamp >= $c) | .uuid)' "$f" 2>/dev/null || true)
        if [[ -n "$has_recent" ]]; then
            analyze_session "$f"
        fi
    done < <(find "$PROJECTS_DIR" -name "*.jsonl" -not -path "*/subagents/*" 2>/dev/null | sort)

else
    # Default: most recent session
    latest=$(find "$PROJECTS_DIR" -name "*.jsonl" -not -path "*/subagents/*" 2>/dev/null \
        | xargs ls -t 2>/dev/null | head -1)
    if [[ -z "$latest" ]]; then
        echo "${RED}No session files found.${RESET}"
        exit 1
    fi
    analyze_session "$latest"
fi

echo ""
echo "${DIM}Tips:${RESET}"
echo "${DIM}  /compact       — Compress context to reduce cache overhead${RESET}"
echo "${DIM}  New session    — Resets the context window entirely${RESET}"
echo "${DIM}  quota-analysis — See token totals by project${RESET}"
echo ""
